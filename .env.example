# Plantilla de configuración del laboratorio F13.
# scripts/setup-env.sh la copia a .env (ignorado por Git) y genera los secretos
# automáticamente al crear el Codespace. No necesitas editarla a mano.
#
# Todos los valores financieros son ILUSTRATIVOS. Sirven para demostrar el metodo,
# no representan datos de ninguna organizacion real.

REQUESTS_PER_MINUTE=120
AVERAGE_REQUEST_VALUE_USD=50
BASELINE_CONVERSION_RATE=0.15
BASELINE_ABANDONMENT_RATE=0.10
DEGRADED_ABANDONMENT_RATE=0.35
AVERAGE_TICKET_USD=50
SLO_TARGET_RATIO=0.999
FAULT_LATENCY_MS=1800
FAULT_ERROR_RATE=0.30

# Credenciales de Grafana. setup-env.sh reemplaza CHANGE_ME por un secreto aleatorio.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME

# Acceso anonimo a Grafana (rol Editor) para explorar dashboards y Explore sin login.
# Es solo una demo: scripts/lab-up.sh publica los puertos web del Codespace.
# Si no quieres acceso anonimo, cambia esto a false y entra con el usuario admin.
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Editor

# URL con la que se abre Grafana en el navegador. En Codespaces, setup-env.sh la
# ajusta a la URL de port forwarding (<codespace>-3000.<dominio>).
# Grafana sigue sirviendo HTTP plano: no hay TLS en el laboratorio.
GF_SERVER_ROOT_URL=http://localhost:3000/

# Token para la API administrativa local de payment-service (activar/desactivar falla).
# setup-env.sh reemplaza CHANGE_ME por un secreto aleatorio.
FAULT_ADMIN_TOKEN=CHANGE_ME

# Nombres de servicio / version para atributos OpenTelemetry.
SERVICE_VERSION=0.1.0
DEPLOYMENT_ENVIRONMENT=demo
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
