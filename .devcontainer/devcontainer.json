{
  "name": "F13 · Observabilidad que sí paga",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [3000, 16686, 9090, 8080],
  "portsAttributes": {
    "3000": {
      "label": "Grafana (dashboards)",
      "protocol": "http",
      "onAutoForward": "notify"
    },
    "16686": {
      "label": "Jaeger (trazas)",
      "protocol": "http",
      "onAutoForward": "silent"
    },
    "9090": {
      "label": "Prometheus (PromQL)",
      "protocol": "http",
      "onAutoForward": "silent"
    },
    "8080": {
      "label": "shop-api (Swagger en /docs)",
      "protocol": "http",
      "onAutoForward": "silent"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "postCreateCommand": "bash scripts/setup-env.sh",
  "postStartCommand": "bash scripts/lab-up.sh",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "redhat.vscode-yaml",
        "timonwong.shellcheck"
      ]
    }
  }
}
